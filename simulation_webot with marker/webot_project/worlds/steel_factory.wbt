DEF MARKER Robot {
  translation 0 0 0.46
  children [
    SliderJoint {
      jointParameters JointParameters {
        axis 0 1 0
        minStop -2.5
        maxStop 2.5
      }
      device [
        LinearMotor {
          name "marker_motor"
          acceleration 15
          maxVelocity 5
          minPosition -0.1
          maxPosition 0.1
        }
        PositionSensor {
          name "marker_motor_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0 0.8
        children [
          Pen {
            translation 0 0 -0.05
            children [
              Pose {
                translation 0 0 0.025
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 1 0.8 0
                    }
                    geometry Box {
                      size 0.01 0.01 0.05
                    }
                  }
                ]
              }
            ]
            inkColor 1 0.8 0
            inkDensity 1
            write FALSE
          }
          Pose {
            translation 0 0 0.025
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 1 0 0
                }
                geometry Cylinder {
                  height 0.06
                  radius 0.02
                }
              }
            ]
          }
        ]
      }
    }
    Camera {
      translation -0.3 0.06 0.5
      rotation 0 1 0 1.57
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 0 1
          }
          geometry Box {
            size 0.04 0.04 0.06
          }
        }
      ]
      width 256
      height 256
    }
  ]
  name "inspection_robot"
  controller "smart_conveyor"
  supervisor TRUE
}
